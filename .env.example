GEMINI_API_KEY=your-key-here
VOYAGE_API_KEY=your-key-here
EMBEDDING_MODEL=voyage-3
CHROMA_DB_PATH=./data/chroma_db
# Set to use a ChromaDB server instead of CHROMA_DB_PATH (docker-compose sets this for you)
# CHROMA_HOST=
# CHROMA_PORT=8000
DATABASE_PATH=./data/askive.db
# Signs login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=1440
# Leave unset for local dev (in-process cache). Set it when running more
# than one API replica, e.g. redis://localhost:6379/0
# REDIS_URL=
CACHE_TTL_SECONDS=3600
# Postgres. Unset = local SQLite file at DATABASE_PATH. docker-compose sets it
# for you; POSTGRES_PASSWORD overrides compose's local-only default password.
# DATABASE_URL=postgresql+psycopg://askive:<password>@localhost:5432/askive
# POSTGRES_PASSWORD=
